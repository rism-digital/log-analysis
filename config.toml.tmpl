[matomo]
url = "https://analytics.example.com"
auth_token = "supersecretkey"
idsite = "1"
batch_size = 600

# Optional: upload detected bots to a separate site on this same Matomo instance.
# When disabled or omitted, bots remain excluded from the primary site.
[bot_routing]
enabled = false
# idsite = "2"

[exclude]
bots = true
paths = [
    "/ignored/path*",
]
extensions = [
    'jpg', 'svgz', 'eot', 'png', 'ttf', 'js', 'svg', 'ico', 'webp',
    'jpeg', 'css', 'woff', 'class', 'woff2', 'xml', 'swf', 'gif',
    'otf', 'bmp', 'webmanifest'
]
